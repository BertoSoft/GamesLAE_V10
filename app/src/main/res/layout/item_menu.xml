<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@color/backcolor"
    style="@style/TarjetaMenu">
    <!-- El estilo crema que creamos antes -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:gravity="center">

        <!-- Icono representativo del juego (ej: Euromillones, Primitiva...) -->
        <ImageView
            android:id="@+id/ivIconoGrande"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/primitiva"
            app:tint="@color/primario" />

        <!-- Layout de datos del sorteo-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:text = "Lunes, 2 de Abril de 2026"/>


            </LinearLayout>

            <!-- texto complementario y reintegro-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6.5"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:text="C"
                    android:textStyle="bold"
                    android:textSize="20dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="R"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="20dp"/>


            </LinearLayout>

            <!-- LInea de bolas premiadas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola3"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola5"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola6"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola7"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola8"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/tvBola9"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    style="@style/TarjetaMenu"/>



            </LinearLayout>


        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>